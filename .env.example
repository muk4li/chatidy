# Non-secret template. Copy outside the checkout; never put a client secret here.
CHATIDY_PUBLIC_ORIGIN=https://chatidy.example.invalid
CHATIDY_TRUSTED_PROXIES=172.30.88.2/32
CHATIDY_OIDC_ISSUER=https://identity.example.invalid/issuer/
CHATIDY_OIDC_AUTHORIZE=https://identity.example.invalid/authorize
CHATIDY_OIDC_TOKEN=https://identity.example.invalid/token
CHATIDY_OIDC_JWKS=https://identity.example.invalid/jwks
CHATIDY_OIDC_CLIENT_ID=replace-with-client-id
CHATIDY_OIDC_CLIENT_SECRET_FILE=/absolute/private/path/client-secret
CHATIDY_OIDC_END_SESSION=https://identity.example.invalid/logout
CHATIDY_PROXY_NETWORK=dnet_rproxy_chatidy
CHATIDY_EGRESS_NETWORK=dnet_chatidy_egress
CHATIDY_DATA_VOLUME=chatidy_data
